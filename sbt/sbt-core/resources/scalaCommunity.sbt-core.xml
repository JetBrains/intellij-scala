<?xml version="1.0" encoding="iso-8859-1"?>
<idea-plugin>
    <dependencies>
        <module name="intellij.platform.core"/>
        <module name="intellij.platform.core.impl"/>
        <module name="intellij.platform.ide.impl"/>
        <module name="intellij.platform.lang"/>
        <module name="intellij.platform.lang.core"/>
        <module name="intellij.platform.util.ui"/>
        <module name="scalaCommunity.scala-api"/>
    </dependencies>

    <extensionPoints>
        <extensionPoint qualifiedName="org.intellij.sbt.sbtVersionProvider" interface="org.jetbrains.sbt.project.SbtVersionProvider" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <moduleType id="SBT_MODULE" implementationClass="org.jetbrains.sbt.project.module.SbtModuleType"/>

        <iconMapper mappingFile="SbtIconMappings.json"/>
    </extensions>
</idea-plugin>
