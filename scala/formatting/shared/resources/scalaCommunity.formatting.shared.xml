<?xml version="1.0" encoding="iso-8859-1"?>
<idea-plugin visibility="public">
    <dependencies>
        <module name="intellij.java.psi"/>
        <module name="intellij.libraries.commons.lang3"/>
        <module name="intellij.platform.analysis"/>
        <module name="intellij.platform.codeStyle"/>
        <module name="intellij.platform.codeStyle.impl"/>
        <module name="intellij.platform.core"/>
        <module name="intellij.platform.core.impl"/>
        <module name="intellij.platform.projectModel"/>
        <module name="scalaCommunity.scala.api"/>
        <module name="scalaCommunity.scala.psi.api"/>
        <module name="scalaCommunity.scala.psi.impl"/>
        <module name="scalaCommunity.settings.shared"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <lang.formatter language="Scala" implementationClass="org.jetbrains.plugins.scala.lang.formatting.ScalaFormattingModelBuilder"/>
        <lang.formatter.restriction implementation="org.jetbrains.plugins.scala.lang.formatting.ScalaLanguageFormattingRestriction"/>

        <postFormatProcessor implementation="org.jetbrains.plugins.scala.lang.formatting.processors.ScalaBracePostFormatProcessor"/>
        <postFormatProcessor implementation="org.jetbrains.plugins.scala.lang.formatting.processors.ScalaTrailingCommaProcessor"/>
        <!-- ScalaFmtPreFormatProcessor in scalaCommunity.formatting.backend goes after it -->
        <preFormatProcessor id="scalaDocNewlinedPreFormatProcessor"
                            implementation="org.jetbrains.plugins.scala.lang.formatting.processors.ScalaDocNewlinedPreFormatProcessor"/>

        <disabledIndentRangesProvider implementation="org.jetbrains.plugins.scala.lang.formatting.scalafmt.ScalaFmtDisabledIndentRangesProvider"/>
    </extensions>
</idea-plugin>
