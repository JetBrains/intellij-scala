    case Iterable[t] => LeafElem[t]
    case AV[t] => t
  }

  summon[LeafElem[String] =:= Char]
  summon[LeafElem[Array[Int]] =:= Int]
  summon[LeafElem[Iterable[Int]] =:= Int]
  summon[LeafElem[Int] =:= Int]
}
