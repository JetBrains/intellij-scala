package test
class Typer {
  def bar(a: Boolean, b: Boolean): Unit = {
    @inline
    def baz(): Unit = {
      ((_: Any) => (Typer.this, a, b)).apply("")
    }
    ((_: Any) => baz()).apply("")
  }
}
