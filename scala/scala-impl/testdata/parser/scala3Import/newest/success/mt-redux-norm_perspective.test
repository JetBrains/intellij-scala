//  |}
//  |+
//  |Inline stack trace
//  |- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  |This location contains code that was inlined from cat.scala:4
//4 |  constValueTuple[m.MirroredElemLabels].toList.toSet
//  |                                               ^

case class Cat(name: String)

def test = foo(using summon[Mirror.Of[Cat]])
