<?xml version="1.0" encoding="iso-8859-1"?>
<idea-plugin>
    <dependencies>
        <module name="intellij.java.analysis.impl"/>
        <module name="intellij.java.compiler"/>
        <module name="intellij.java.compiler.impl"/>
        <module name="intellij.java.frontback.psi"/>
        <module name="intellij.java.psi"/>
        <module name="intellij.java.psi.impl"/>
        <module name="intellij.libraries.commons.lang3"/>
        <module name="intellij.libraries.kotlinx.coroutines.core"/>
        <module name="intellij.libraries.opentelemetry"/>
        <module name="intellij.platform.analysis"/>
        <module name="intellij.platform.analysis.impl"/>
        <module name="intellij.platform.core"/>
        <module name="intellij.platform.core.impl"/>
        <module name="intellij.platform.editor.ui"/>
        <module name="intellij.platform.eel.provider"/>
        <module name="intellij.platform.execution"/>
        <module name="intellij.platform.ide.core"/>
        <module name="intellij.platform.ide.impl"/>
        <module name="intellij.platform.jps.build"/>
        <module name="intellij.platform.lang"/>
        <module name="intellij.platform.lang.impl"/>
        <module name="intellij.platform.projectFrame"/>
        <module name="intellij.platform.projectModel"/>
        <module name="intellij.platform.util.ex"/>
        <module name="intellij.platform.util.ui"/>
        <module name="scalaCommunity.bsp"/>
        <module name="scalaCommunity.compiler-integration"/>
        <module name="scalaCommunity.compiler-integration-server-management"/>
    </dependencies>

    <extensionPoints>
        <extensionPoint qualifiedName="org.intellij.scala.worksheetHighlightingCompiler"
                        interface="org.jetbrains.plugins.scala.compiler.highlighting.compilers.WorksheetHighlightingCompiler"
                        dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <trafficLightRendererContributor implementation="org.jetbrains.plugins.scala.compiler.highlighting.core.CustomTrafficLightRendererContributor"/>
        <compiler.task execute="BEFORE" implementation="org.jetbrains.plugins.scala.compiler.highlighting.core.EraseCompilerProcessJdkOnce"/>

        <highlightErrorFilter implementation="org.jetbrains.plugins.scala.compiler.highlighting.core.CompilerHighlightingErrorFilter"/>

        <compiler.isUpToDateCheckConsumer implementation="org.jetbrains.plugins.scala.compiler.highlighting.core.CompilerHighlightingUpToDateChecker"/>

        <registryKey key="scala.erase.compiler.process.jdk.once" defaultValue="true" restartRequired="false"
                     description="Erase compiler.process.jdk value before compilation. A dirty hack needed because of removal of SetSameJdkToBuildProcessAsInCompileServer #SCL-17676"/>

        <registryKey key="scala.compiler.highlighting.document.use.in.memory.file" defaultValue="false" restartRequired="false"
                     description="When enabled, uses an in-memory file for document compilation"/>

        <registryKey key="scala.compiler.highlighting.tracing.enabled" defaultValue="false" restartRequired="true"
                     description="Enables tracing of compilation and highlighting events when compiler error highlighting is enabled"/>

        <projectService serviceImplementation="org.jetbrains.plugins.scala.compiler.highlighting.services.CompilationLogicService"/>

        <vfs.asyncListener implementation="org.jetbrains.plugins.scala.compiler.highlighting.listeners.CompilerHighlightingFileListener"/>

        <postStartupActivity implementation="org.jetbrains.plugins.scala.compiler.highlighting.core.CompilerHighlightingSetupActivity"/>
    </extensions>

    <applicationListeners>
        <listener topic="com.intellij.compiler.server.BuildManagerListener"
                  class="org.jetbrains.plugins.scala.compiler.highlighting.listeners.CompilerHighlightingBuildManagerListener"/>
    </applicationListeners>

    <projectListeners>
        <listener topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"
                  class="org.jetbrains.plugins.scala.compiler.highlighting.listeners.CompilerHighlightingFileEditorListener"/>

        <listener topic="org.jetbrains.plugins.scala.compiler.CompilerEventListener"
                  class="org.jetbrains.plugins.scala.compiler.highlighting.listeners.UpdateCompilerGeneratedStateListener"/>

        <listener topic="org.jetbrains.plugins.scala.compiler.CompilerEventListener"
                  class="org.jetbrains.plugins.scala.compiler.highlighting.listeners.ExternalBuildStateListener"/>

        <listener topic="org.jetbrains.plugins.scala.lang.psi.impl.CompilerType$Listener"
                  class="org.jetbrains.plugins.scala.compiler.highlighting.listeners.CompilerTypeRequestListener"/>

        <listener topic="com.intellij.openapi.roots.ModuleRootListener"
                  class="org.jetbrains.plugins.scala.compiler.highlighting.listeners.CompilerHighlightingModuleRootListener"/>

        <listener topic="org.jetbrains.plugins.scala.settings.CompilerHighlightingListener"
                  class="org.jetbrains.plugins.scala.compiler.highlighting.listeners.ToggleHighlightingModeListener$OnCompilerHighlightingChange"
                  activeInTestMode="false"
                  />
        <listener topic="com.intellij.openapi.roots.ModuleRootListener"
                  class="org.jetbrains.plugins.scala.compiler.highlighting.listeners.ToggleHighlightingModeListener$OnModuleRootChange"
                  activeInTestMode="false"
                  />
    </projectListeners>
</idea-plugin>
