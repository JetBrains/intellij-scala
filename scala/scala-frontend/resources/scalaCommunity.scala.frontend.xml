<?xml version="1.0" encoding="iso-8859-1"?>
<idea-plugin visibility="public">
    <dependencies>
        <module name="intellij.platform.analysis.impl"/>
        <module name="intellij.platform.core"/>
        <module name="intellij.platform.core.ui"/>
        <module name="intellij.platform.editor.ui"/>
        <module name="intellij.platform.frontend"/>
        <module name="intellij.platform.ide"/>
        <module name="intellij.platform.ide.core"/>
        <module name="intellij.platform.ide.impl"/>
        <module name="intellij.platform.lang.impl"/>
        <module name="intellij.platform.util.ui"/>
        <module name="scalaCommunity.editor.shared"/>
        <module name="scalaCommunity.scala.api"/>
        <module name="scalaCommunity.scala.psi.impl"/>
        <module name="scalaCommunity.settings.shared"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <autoImportOptionsProvider instance="org.jetbrains.plugins.scala.editor.autoimport.ScalaAutoImportOptionsProvider"/>
        <codeFoldingOptionsProvider instance="org.jetbrains.plugins.scala.editor.codeFolding.ScalaCodeFoldingOptionsProvider"/>
    </extensions>
</idea-plugin>
