<?xml version="1.0" encoding="iso-8859-1"?>
<idea-plugin>
    <dependencies>
        <module name="intellij.java.frontback.psi"/>
        <module name="intellij.java.psi"/>
        <module name="intellij.java.structureView"/>
        <module name="intellij.platform.core"/>
        <module name="intellij.platform.editor.ui"/>
        <module name="intellij.platform.ide"/>
        <module name="intellij.platform.lang"/>
        <module name="intellij.platform.structureView"/>
        <module name="intellij.platform.util.ui"/>
    </dependencies>

    <extensionPoints>
        <extensionPoint qualifiedName="org.intellij.scala.structureViewModelProvider"
                        interface="org.jetbrains.plugins.scala.structureView.ScalaStructureViewModelProvider"
                        dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <lang.psiStructureViewFactory language="Scala"
                                      implementationClass="org.jetbrains.plugins.scala.structureView.ScalaStructureViewFactory"/>
        <navbar implementation="org.jetbrains.plugins.scala.structureView.ScalaNavBarModelExtension" order="first"/> <!-- before Java -->
    </extensions>
</idea-plugin>
