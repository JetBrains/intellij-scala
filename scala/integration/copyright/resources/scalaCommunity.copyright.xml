<?xml version="1.0" encoding="iso-8859-1"?>
<idea-plugin>
    <dependencies>
        <plugin id="com.intellij.copyright"/>
        <module name="intellij.platform.core"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij.copyright">
        <updater filetype="Scala" implementationClass="org.jetbrains.plugins.scala.copyright.UpdateScalaCopyrightsProvider"/>
        <variablesProvider filetype="Scala" implementationClass="org.jetbrains.plugins.scala.copyright.ScalaCopyrightVariablesProvider"/>
    </extensions>
</idea-plugin>
