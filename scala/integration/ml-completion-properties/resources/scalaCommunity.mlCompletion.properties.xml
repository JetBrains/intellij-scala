<?xml version="1.0" encoding="UTF-8"?>
<idea-plugin package="org.jetbrains.plugins.sbt.completion.ml">
    <dependencies>
        <plugin id="com.intellij.completion.ml.ranking"/>
        <plugin id="com.intellij.properties"/>
        <module name="scalaCommunity.mlCompletion"/>
        <module name="scalaCommunity.properties"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij.completion.ml.ranking">
        <policy language="Properties"
                implementationClass="org.jetbrains.plugins.sbt.completion.ml.SbtDependencyVersionInPropertyFilesCompletionMLPolicy"/>
    </extensions>
</idea-plugin>
