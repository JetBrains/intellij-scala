<idea-plugin>
    <dependencies>
        <module name="intellij.repository.search.completion"/>
        <module name="scalaCommunity.repository-search.common"/>
    </dependencies>

    <extensions defaultExtensionNs="org.jetbrains.idea.reposearch">
        <contributor implementation="org.jetbrains.plugins.scala.reposearch.ScalaLocalDependencyCompletionContributor"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <registryKey key="scala.dependency.completion.contributor.coursier" defaultValue="true"
                     description="Scala coursier-based dependency completion contributor enabled"/>
    </extensions>
</idea-plugin>
