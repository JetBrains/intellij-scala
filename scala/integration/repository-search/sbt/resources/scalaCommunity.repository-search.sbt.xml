<idea-plugin>
    <dependencies>
        <module name="intellij.repository.search.completion"/>
        <module name="scalaCommunity.repository-search.common"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <completion.contributor language="Scala"
                                implementationClass="org.jetbrains.plugins.scala.reposearch.sbt.SbtDependencyCoordinatesCompletionContributor"
                                order="first" id="sbtDependencyCoordinatesCompletionContributor"/>
    </extensions>
</idea-plugin>
