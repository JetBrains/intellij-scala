<?xml version="1.0" encoding="iso-8859-1"?>
<idea-plugin>
    <dependencies>
        <plugin id="org.jetbrains.java.decompiler"/>
        <module name="intellij.java"/>
        <module name="intellij.java.frontback.psi.impl"/>
        <module name="intellij.java.psi"/>
        <module name="intellij.java.psi.impl"/>
        <module name="intellij.platform.analysis"/>
        <module name="intellij.platform.analysis.impl"/>
        <module name="intellij.platform.codeStyle"/>
        <module name="intellij.platform.core"/>
        <module name="intellij.platform.core.impl"/>
        <module name="intellij.platform.core.ui"/>
        <module name="intellij.platform.editor.ui"/>
        <module name="intellij.platform.ide"/>
        <module name="intellij.platform.lang"/>
        <module name="intellij.platform.lang.impl"/>
        <module name="intellij.platform.projectModel"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <attachSourcesProvider implementation="org.jetbrains.plugins.scala.decompileToJava.DecompileScalaToJavaActionProvider"/>
        <applicationService serviceInterface="org.jetbrains.plugins.scala.decompileToJava.ScalaDecompilerService"
                            serviceImplementation="org.jetbrains.plugins.scala.decompileToJava.ScalaDecompilerServiceImpl"/>
        <writingAccessProvider implementation="org.jetbrains.plugins.scala.decompileToJava.DecompiledScalaFileWritingAccessProvider"/>
    </extensions>

    <actions>
        <action id="Scala.DecompileToJava"
                class="org.jetbrains.plugins.scala.decompileToJava.ShowDecompiledClassAsJavaAction"
                description="Run FernFlower decompiler on given classfile">
            <add-to-group group-id="idea.java.decompiler.action.group" anchor="after" relative-to-action="ByteCodeDecompiler"/>
            <!--Leaving the action in RunContextPopupGroup as well for easy access from Project Tree view -->
            <add-to-group group-id="RunContextPopupGroup" anchor="last"/>
        </action>
        <action id="Scala.DecompileTasty"
                class="org.jetbrains.plugins.scala.decompileToJava.ShowDecompiledTastyAction">
            <add-to-group group-id="idea.java.decompiler.action.group" anchor="after" relative-to-action="Scala.DecompileToJava"/>
        </action>

        <action id="Scala.DecompileTastyRaw"
                class="org.jetbrains.plugins.scala.decompileToJava.ShowDecompiledTastyRawInternalAction"
                internal="true"
                description="Shows internal representation of the Tasty file (Trees and Name table)">
            <add-to-group group-id="idea.java.decompiler.action.group" anchor="after" relative-to-action="Scala.DecompileTasty"/>
        </action>
    </actions>
</idea-plugin>
