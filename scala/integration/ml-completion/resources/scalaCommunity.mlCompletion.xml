<?xml version="1.0" encoding="UTF-8"?>
<idea-plugin>
    <dependencies>
        <plugin id="com.intellij.completion.ml.ranking"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij.completion.ml">
        <ranking.features.policy language="Scala" implementationClass="org.jetbrains.plugins.scala.mlCompletion.ScalaCompletionFeaturesPolicy"/>
        <model implementation="org.jetbrains.plugins.scala.mlCompletion.ScalaMlRankingProvider"/>

        <ranking.policy language="sbt" implementationClass="org.jetbrains.plugins.scala.mlCompletion.sbt.SbtDependencyVersionInSbtAndScalaFilesCompletionMLPolicy"/>
        <ranking.policy language="Scala" implementationClass="org.jetbrains.plugins.scala.mlCompletion.sbt.SbtDependencyVersionInSbtAndScalaFilesCompletionMLPolicy"/>
    </extensions>
</idea-plugin>
