<?xml version="1.0" encoding="iso-8859-1"?>
<idea-plugin>
    <dependencies>
        <module name="intellij.java.psi"/>
        <module name="intellij.java.ui"/>
        <module name="intellij.platform.analysis"/>
        <module name="intellij.platform.backend.workspace"/>
        <module name="intellij.platform.core"/>
        <module name="intellij.platform.editor.ui"/>
        <module name="intellij.platform.externalSystem"/>
        <module name="intellij.platform.ide.core"/>
        <module name="intellij.platform.projectModel"/>
        <module name="intellij.platform.projectModel.impl"/>
        <module name="intellij.platform.workspace.jps"/>
        <module name="intellij.platform.workspace.storage"/>
    </dependencies>

    <actions>
        <action class="org.jetbrains.idea.devkit.scala.AttachIntellijSourcesAction"
                text="Attach IntelliJ Sources"
                internal="true">
            <add-to-group group-id="MaintenanceGroup"/>
        </action>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <localInspection implementationClass="org.jetbrains.idea.devkit.scala.codeInspection.internal.UnitReturnTypeInSuspendFunctionOverride"
                         language="Scala"
                         bundle="messages.ScalaDevkitBundle"
                         key="displayname.overridden.suspend.function.with.unit.return.type"
                         groupPath="Scala" groupKey="group.internal"
                         isInternal="true" level="WARNING" enabledByDefault="true"/>
    </extensions>
</idea-plugin>
