<?xml version="1.0" encoding="iso-8859-1"?>
<idea-plugin>
    <dependencies>
        <module name="intellij.java"/>
        <module name="intellij.java.compiler"/>
        <module name="intellij.java.compiler.impl"/>
        <module name="intellij.java.syntax"/>
        <module name="intellij.java.ui"/>
        <module name="intellij.libraries.commons.lang3"/>
        <module name="intellij.libraries.kotlinx.coroutines.core"/>
        <module name="intellij.platform.analysis"/>
        <module name="intellij.platform.core"/>
        <module name="intellij.platform.core.ui"/>
        <module name="intellij.platform.editor.ui"/>
        <module name="intellij.platform.eel.provider"/>
        <module name="intellij.platform.ide"/>
        <module name="intellij.platform.ide.core"/>
        <module name="intellij.platform.ide.impl"/>
        <module name="intellij.platform.jps.build"/>
        <module name="intellij.platform.lang.core"/>
        <module name="intellij.platform.lang.impl"/>
        <module name="intellij.platform.projectModel"/>
        <module name="intellij.platform.projectModel.impl"/>
        <module name="intellij.platform.util.ui"/>
        <module name="scalaCommunity.bsp"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable bundle="messages.ServerManagementBundle"
                             key="displayname.scala.compile.server"
                             parentId="scala.compiler"
                             instance="org.jetbrains.plugins.scala.compiler.ScalaCompileServerForm"/>

        <compiler.task execute="BEFORE" implementation="org.jetbrains.plugins.scala.compiler.PrepareCompileServerTask"/>


        <statusBarWidgetFactory id="ScalaCompileServer" implementation="org.jetbrains.plugins.scala.compiler.CompileServerWidgetFactory" order="before ScalaHighlightingMode"/>
    </extensions>

    <applicationListeners>

        <listener topic="org.jetbrains.plugins.scala.compiler.CompileServerErrorListener"
                  class="org.jetbrains.plugins.scala.compiler.CompileServerErrorListenerImpl"
                  activeInTestMode="false"/>
    </applicationListeners>

    <actions resource-bundle="messages.ServerManagementBundle">
        <action id="Scala.OpenCompileServerLog"
                internal="true"
                class="org.jetbrains.plugins.scala.compiler.actions.internal.OpenCompileServerLogAction">
            <add-to-group group-id="HelpMenu" anchor="before" relative-to-action="Scala.ShowCompileServerLog"/>
        </action>

        <action id="Scala.ShowCompileServerLog"
                internal="true"
                class="org.jetbrains.plugins.scala.compiler.actions.internal.ShowCompileServerLogAction">
            <add-to-group group-id="HelpMenu" anchor="after" relative-to-action="ShowLog"/>
            <synonym key="show.compile.server.log.synonym.finder"/>
            <synonym key="show.compile.server.log.synonym.explorer"/>
        </action>
    </actions>
</idea-plugin>
