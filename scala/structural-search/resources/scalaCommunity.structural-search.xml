<?xml version="1.0" encoding="iso-8859-1"?>
<idea-plugin>
    <dependencies>
        <module name="intellij.java.psi"/>
        <module name="intellij.platform.analysis"/>
        <module name="intellij.platform.analysis.impl"/>
        <module name="intellij.platform.core"/>
        <module name="intellij.platform.core.impl"/>
        <module name="intellij.platform.duplicates.analysis"/>
        <module name="intellij.platform.structuralSearch"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij.structuralsearch">
        <profile implementation="org.jetbrains.plugins.scala.structuralSearch.ScalaStructuralSearchProfile"/>
        <filterProvider implementation="org.jetbrains.plugins.scala.structuralSearch.ScalaFilterProvider"/>
    </extensions>
</idea-plugin>
