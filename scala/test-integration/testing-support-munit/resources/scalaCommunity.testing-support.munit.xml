<?xml version="1.0" encoding="iso-8859-1"?>
<idea-plugin visibility="public">
    <dependencies>
        <plugin id="JUnit"/>
        <module name="intellij.java.execution"/>
        <module name="intellij.java.execution.impl"/>
        <module name="intellij.java.psi"/>
        <module name="intellij.platform.core"/>
        <module name="intellij.platform.execution"/>
        <module name="intellij.platform.execution.impl"/>
        <module name="intellij.platform.smRunner"/>
        <module name="intellij.platform.testIntegration"/>
        <module name="intellij.platform.testRunner"/>
        <module name="scalaCommunity.testing-support"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <testFramework implementation="org.jetbrains.plugins.scala.testingSupport.test.munit.MUnitTestFramework"/>

        <configurationType implementation="org.jetbrains.plugins.scala.testingSupport.test.munit.MUnitConfigurationType"/>

        <runConfigurationProducer implementation="org.jetbrains.plugins.scala.testingSupport.test.munit.MUnitConfigurationProducer"/>
    </extensions>
</idea-plugin>
